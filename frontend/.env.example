# 이 파일을 복사해서 .env.local로 만들고 실제 값을 채워넣으세요.
# .env.local은 .gitignore에 의해 절대 Git에 올라가지 않습니다.

# Supabase 프로젝트 정보 (Auth용, 브라우저에 노출돼도 되는 값만)
# 대시보드 -> Project Settings -> API -> Project URL / Publishable key
# 주의: Project URL은 REST 경로(/rest/v1/) 없이 base URL만 넣어야 합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
