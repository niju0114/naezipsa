            "body": {
              "mode": "raw",
              "raw": "{\n  \"size_id\": 1314,\n  \"dong\": \"101\",\n  \"ho\": \"1203\",\n  \"floor\": 12,\n  \"list_price\": 450000,\n  \"direction\": \"south\",\n  \"interior_state\": \"partial\",\n  \"memo\": \"남향, 재건축 기대\"\n}"
