{
  "info": {
    "name": "naezipsa API",
    "description": "내집사 백엔드 API.\n\n사용 전에:\n1) 백엔드 실행:  cd backend && uvicorn app.main:app --reload\n2) 토큰 발급:    python scripts/make_test_token.py\n3) 이 컬렉션의 Variables 탭에서 token 값에 붙여넣기\n\n'로그인 불필요' 폴더는 토큰 없이도 됩니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1"
    },
    {
      "key": "token",
      "value": "",
      "description": "scripts/make_test_token.py 로 발급받아 붙여넣기"
    },
    {
      "key": "sizeId",
      "value": "1314",
      "description": "평형 id. show_status.py 나 평형목록으로 확인"
    },
    {
      "key": "complexId",
      "value": "624"
    },
    {
      "key": "itemId",
      "value": "1",
      "description": "후보 등록 응답의 id를 넣으세요"
    }
  ],
  "item": [
    {
      "name": "0. 상태확인",
      "item": [
        {
          "name": "헬스체크",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": [
                "{{baseUrl}}"
              ],
              "path": []
            },
            "description": "서버가 살아있는지. 이것만 /api/v1 없이 http://localhost:8000/ 입니다.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. 로그인 불필요 (B 실거래)",
      "item": [
        {
          "name": "B-01 단지 검색",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/search?keyword=래미안",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "search"
              ],
              "query": [
                {
                  "key": "keyword",
                  "value": "래미안"
                }
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "B-02 평형 목록",
